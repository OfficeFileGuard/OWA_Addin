<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" 
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" 
           xsi:type="MailApp">
  
  <!-- ===== SEZIONE PRINCIPALE ===== -->
  <Id>46751a0b-28a9-4c50-bbe1-a76e123d8121</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>BlueCrocodile</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  
  <!-- Nomi e descrizioni -->
  <DisplayName DefaultValue="OutlookFileGuard OWA"/>
  <Description DefaultValue="This is the Outlook New/OWA (free account) Add-in of the OfficeFileGuard solution"/>
  
  <!-- Icone -->
  <IconUrl DefaultValue="https://localhost:3000/assets/color.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/outline.png"/>
  
  <!-- Supporto e domini -->
  <SupportUrl DefaultValue="https://www.bluecrocodile.it/support"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  
  <!-- Host e requisiti -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  
  <!-- Form per la lettura (è obbligatorio per il formato XML) -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  
  <!-- Permessi -->
  <Permissions>ReadWriteItem</Permissions>
  
  <!-- Regola per attivare l'add-in -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  
  <!-- ===== VERSIONE OVERRIDES PER EVENTI ===== -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <!-- Annidamento di V1_1 all'interno di V1_0 (obbligatorio per avere il supporto a Events -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">


      <!-- Requisiti della versione overrides -->
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
    
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            
            <!-- File che contiene le funzioni -->
            <FunctionFile resid="Commands.Url"/>
            
            <!-- EVENTO: intercetta l'invio dell'email (uso ItemSend -deprecato- ma è l'unico che funziona con manifest in xml)-->
            <ExtensionPoint xsi:type="Events">
              <Event Type="OnMessageSend"  
                    FunctionExecution="synchronous"
                    FunctionName="onMessageSendHandler"/>
            </ExtensionPoint>
            
          </DesktopFormFactor>
        </Host>
      </Hosts>
    
      <!-- Risorse -->
      <Resources>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
        </bt:Urls>
      </Resources>
    
    </VersionOverrides> <!-- chiusura V1_1 -->

  </VersionOverrides> <!-- chiusura V1_0 -->
  
</OfficeApp>